<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="BR_QImport.MainWindow"
        Title="BOXROOM Quick Import"
        Width="700"
        Height="520"
        MinWidth="650"
        MinHeight="500">

    <Grid Margin="15"
          RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="BOXROOM Steam Quick Import"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,12"/>

        <!-- Steam JSON -->
        <GroupBox Grid.Row="1"
                  Header="Steam UserData JSON">

            <Grid Margin="10"
                  ColumnDefinitions="*,Auto,Auto"
                  ColumnSpacing="8">

                <TextBox x:Name="JsonTextBox"
                         VerticalAlignment="Center"
                         Watermark="Select userdata.json..." />

                <Button Grid.Column="1"
                        x:Name="BrowseJsonButton"
                        Content="Browse..."
                        Click="BrowseJsonButton_Click"/>

                <Button Grid.Column="2"
                        x:Name="OpenSteamButton"
                        Content="Steam Page"
                        Click="OpenSteamButton_Click"/>

            </Grid>

        </GroupBox>

        <!-- Cache -->
        <GroupBox Grid.Row="2"
                  Header="BOXROOM Cache"
                  Margin="0,12,0,0">

            <Grid Margin="10"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="8">

                <TextBox x:Name="CacheDirectoryTextBox"
                         VerticalAlignment="Center"
                         Watermark="steam_cache_v2"/>

                <Button Grid.Column="1"
                        x:Name="BrowseCacheButton"
                        Content="Browse..."
                        Click="BrowseCacheButton_Click"/>

            </Grid>

        </GroupBox>

        <!-- Progress -->
        <GroupBox Grid.Row="3"
                  Header="Progress"
                  Margin="0,12,0,0">

            <StackPanel Margin="10"
                        Spacing="6">

                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Text="Status:"
                               FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1"
                               x:Name="StatusLabel"
                               Margin="8,0,0,0"
                               Text="Ready"/>
                </Grid>

                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Text="Game:"
                               FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1"
                               x:Name="CurrentGameLabel"
                               Margin="8,0,0,0"
                               Text="-"/>
                </Grid>

                <ProgressBar x:Name="ImportProgressBar"
                             Height="18"
                             Minimum="0"
                             Maximum="100"/>

                <TextBlock x:Name="ProgressLabel"
                           HorizontalAlignment="Center"
                           Text="0 / 0"/>

            </StackPanel>

        </GroupBox>

        <!-- Footer -->
        <DockPanel Grid.Row="4"
                   Margin="0,12,0,0">

            <StackPanel Orientation="Horizontal"
                        Spacing="12"
                        DockPanel.Dock="Left">

                <CheckBox x:Name="ScrapeCheckBox"
                          Content="Metadata"
                          IsChecked="True"/>

                <CheckBox x:Name="CoverArtCheckBox"
                          Content="Cover Art"
                          IsChecked="True"/>

                <CheckBox x:Name="ScreenshotCheckBox"
                          Content="Screenshots"
                          IsChecked="False"/>

            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Right"
                        DockPanel.Dock="Right">

                <Button x:Name="ImportButton"
                        Width="90"
                        Content="Import"
                        Click="ImportButton_Click"/>

                <Button x:Name="CloseButton"
                        Width="90"
                        Content="Close"
                        Click="CloseButton_Click"/>

            </StackPanel>

        </DockPanel>

    </Grid>

</Window>